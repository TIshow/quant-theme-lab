{
  "name": "quant-theme-lab",
  "version": "0.1.0",
  "description": "Quantamental theme analysis platform",
  "private": true,
  "scripts": {
    "setup": "uv sync",
    "universe": "uv run python run_universe.py",
    "pipeline": "uv run python run_pipeline.py",
    "analyze": "uv run python analyze_stock.py",
    "test": "uv run pytest tests/ -v",
    "validate": "uv run pytest tests/ -v --tb=short",
    "format": "prettier --write \"data/reports/**/*.html\""
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
