{
  "name": "quant-theme-lab",
  "version": "0.1.0",
  "description": "Quantamental theme analysis platform",
  "private": true,
  "scripts": {
    "setup": "pip install -r requirements.txt",
    "universe": "python run_universe.py",
    "pipeline": "python run_pipeline.py",
    "analyze": "python analyze_stock.py",
    "test": "pytest tests/ -v",
    "validate": "python -m pytest tests/ -v --tb=short",
    "format": "prettier --write \"data/reports/**/*.html\""
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
